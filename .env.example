# Grove works without a .env file. Copy this to .env only to change a default.

# Grove's own Postgres, started by `npm run dev` through docker compose.
DATABASE_URL=postgres://grove:grove@127.0.0.1:54329/grove

# GitHub access for private repos and higher rate limits.
# Leave empty to reuse your GitHub CLI login (`gh auth login`).
GITHUB_TOKEN=

# How often Grove asks GitHub for new commits, in milliseconds.
POLL_INTERVAL_MS=5000

# Apps are served at http://<app>.localhost. Grove uses port 80 when it can and
# falls back to 3080 (http://<app>.localhost:3080). Set a port to pin it.
APPS_PORT=

# Optional instant deploys through GitHub webhooks. Needs a public URL such as a
# tunnel pointing at http://localhost:3030/api/webhooks/github.
GITHUB_WEBHOOK_SECRET=

# Serve only the landing page. Vercel deployments turn this on automatically.
LANDING_ONLY=
